{
  "name": "noor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "preview:phone": "VITE_MOCK=1 vite --host --port 1440",
    "build:preview": "VITE_MOCK=1 vite build --base ./ --outDir dist-preview",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --workspace --exclude noor",
    "test:all": "npm run typecheck && npm test && npm run test:rust",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "ios:init": "bash scripts/ios-setup.sh",
    "ios:dev": "bash scripts/ios-run.sh dev",
    "ios:sim": "bash scripts/ios-run.sh dev \"iPhone 16 Pro\"",
    "ios:build": "bash scripts/ios-run.sh build",
    "icons": "tauri icon app-icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "happy-dom": "^15.11.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.0"
  }
}
